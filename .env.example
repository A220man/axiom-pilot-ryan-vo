# Application
APP_NAME=axiom-pilot-ryan-vo
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Security - MUST be set in production
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session/Cookie
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=csrf_token

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/axiom-pilot
OIDC_CLIENT_ID=axiom-pilot
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
OIDC_SCOPES=openid,profile,email,roles
OIDC_LOGOUT_URI=http://127.0.0.1:8080/realms/axiom-pilot/protocol/openid-connect/logout

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://127.0.0.1:5173

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Demo mode (localhost only, refuses in production)
DEMO_MODE=false

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Postgres (optional, for production profile)
POSTGRES_PASSWORD=changeme